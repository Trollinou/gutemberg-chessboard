  },
  "homepage": "https://github.com/trollinou/gutemberg-chessboard#readme",
  "devDependencies": {
    "@types/node": "^20.14.11",
    "prettier": "^3.2.2",
    "vitepress": "^1.3.1"
  },
  "dependencies": {
    "stockfish.js": "^10.0.2",
    "gutemberg-chessboard": "file:.."
